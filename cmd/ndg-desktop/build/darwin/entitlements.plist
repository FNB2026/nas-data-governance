<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        NDG 数据治理工作台 — Hardened Runtime Entitlements

        This app is distributed via DMG outside the Mac App Store.
        App Sandbox is NOT enabled (sandbox is only required for MAS).

        The cs.* entitlements below relax Hardened Runtime restrictions
        needed by the Wails v2 runtime (WKWebView / WebKit):
    -->

    <!-- Allow JIT compilation (WebKit rendering) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (WebKit JavaScript engine) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading third-party dylibs without matching team ID -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow DYLD environment variables (debugging / dynamic loading) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Network access (NAS scanning, local API) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- User-selected file access (directory picker, scan sources) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Downloads folder access -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
</dict>
</plist>
