#!/bin/sh
# App Center owns Compose start/stop. This research scaffold cannot start a service.
set -eu
reject() {
    printf '%s\n' 'ndg_fnos: unsupported_runtime_integration' >&2
    exit 1
}
case "${1:-}" in
    status)
        # Fixed package identity only. Never print inspect output or daemon errors.
        if ! result=$(docker inspect --format '{{index .Config.Labels "com.ndg.fnos.app"}}|{{index .Config.Labels "com.ndg.fnos.channel"}}|{{.State.Running}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' ndg-readonly-test-web 2>/dev/null); then
            exit 3
        fi
        [ "$result" = 'ndg-readonly-test|fnos-research|true|healthy' ] && exit 0
        exit 3
        ;;
    start|stop|*) reject ;;
esac
